# ---------------------------------------------------------------------------
# Drift og inspeksjon – konfigurasjon
# Kopier til .env (eller .env.local) og fyll inn. VITE_-variabler havner i
# klientbundelen – legg ALDRI passord eller hemmeligheter i VITE_-variabler.
# ---------------------------------------------------------------------------

# true = kjør helt uten portal, med lokale mockdata (E45 Kløfta B12016)
VITE_USE_MOCK=true

# ArcGIS Enterprise (SVV) eller ArcGIS Online (pilot: https://geodata.maps.arcgis.com,
# webkart d41d15c2c72b4498992d7b6428d7f23e, webscene 87fcf27968834310a7da2fda6b637d05)
VITE_PORTAL_URL=https://kart.vegvesen.no/portal
# TODO(SVV): App-ID fra app-registreringen i portalen (Content > Add item > Application > Register)
VITE_APP_ID=

# Webkart og webscene i portalen
VITE_WEBMAP_ID=97e21f38b3d94468bb414fa8cb7bc6a6
# TODO(SVV): ID for webscenen (3D)
VITE_WEBSCENE_ID=

# Objektlag. Hver variabel er en kommaseparert liste med enten
#  - URL til et feature-lag (…/FeatureServer/3), eller
#  - tittelen på et lag i webkartet, prefikset med "tittel:" (f.eks. tittel:Overvann)
# Er alle tomme, kartlegges webkartet automatisk ut fra feltene (se README).
# TODO(SVV): fyll inn når lagene i webkartet er kartlagt (bruk ?diagnose=1 etter innlogging)
VITE_LAYERS_VA=
VITE_LAYERS_ELEKTRO=
VITE_LAYERS_VEG=
VITE_TABLE_INSPEKSJONER=
VITE_LAYER_OPPGAVER=
# Punktlag med feltbilder som vedlegg (valgfritt). Senere: Trimble Connect.
VITE_LAYER_FELTBILDER=
VITE_TABLE_DOKUMENTER=
# Valgfritt: i3s-scenelag for fagmodeller, "Navn|URL" kommaseparert
VITE_SCENE_LAYERS=

# TODO(SVV): ID for portalgruppen med Geodata Online-bakgrunnskart (UTM33)
VITE_BASEMAP_GROUP_ID=
# TODO(SVV): utskriftstjeneste i Enterprise (…/PrintingTools/GPServer/Export Web Map Task)
VITE_PRINT_URL=

# NVDB API Les krever X-Client-header – avtal navn med SVV
VITE_NVDB_CLIENT=svv-drift-og-inspeksjon

# Geofence
VITE_GPS_MAX_ACCURACY_M=10
VITE_GEOFENCE_RADIUS_M=15

# ---------------------------------------------------------------------------
# Kun for utvikling (lest av Vite-serveren, sendes IKKE til klienten):
# Geodata Online-bruker for å hente token til bakgrunnskart, terreng og adressesøk
# i mock-modus. Legg disse i .env.local.
# GDO_USERNAME=
# GDO_PASSWORD=
# ---------------------------------------------------------------------------
